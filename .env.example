# Copy this file to .env and fill in your keys, then restart `npm run dev`.

# Supabase (required) — Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=your_supabase_anon_key

# AI provider keys (fill in the ones you use).
# These are read ONLY by the server functions in /api, never shipped to the browser.
# The older VITE_GROQ_KEY / VITE_GEMINI_KEY / VITE_OPENROUTER_KEY names still work.
GROQ_KEY=
GEMINI_KEY=
OPENROUTER_KEY=
